+void AP_OSD_Screen::draw_loiter_radius(uint8_t x, uint8_t y)
+{
+    enum ap_var_type ptype;
+    AP_Int16 *loiter_rad =
+        (AP_Int16 *)AP_Param::find("WP_LOITER_RAD", &ptype);
+
+    int radius_display = 0;
+
+    if (loiter_rad != nullptr) {
+
+        if (loiter_radius_units == 0) {
+            radius_display =
+                (int)((float)loiter_rad->get() * 3.28084f);
+        } else {
+            radius_display =
+                loiter_rad->get();
+        }
+    }
+
+    backend->write(x, y, false, "R:%d", radius_display);
+}
